---
export interface Props {
	title: string;
	description?: string;
	image?: string;
	url?: string;
	isNSFW?: boolean;  // 追加
}

const { title, description, image, url, isNSFW = false } = Astro.props;

// サイトの基本情報
const siteName = "Dragontail";
const siteUrl = "https://dragontail.monster";
const defaultDescription = "ドラゴンガールとケモミミが好きな絵描き、しもふみさんによるイラストサイト。オリジナルも二次創作も。";
const defaultImage = `${siteUrl}/yakinasu_ogp.png`;

const pageDescription = description || defaultDescription;
const pageImage = image ? `${siteUrl}${image}` : defaultImage;
const pageUrl = url ? `${siteUrl}${url}` : siteUrl;
---

<!doctype html>
<html lang="ja">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<link rel="stylesheet" href="/styles/style.css" />
		<meta name="generator" content={Astro.generator} />
		<!-- RSS Feed -->
		<link rel="alternate" type="application/rss+xml" 
        title={isNSFW ? "Dragontail NSFW RSS" : "Dragontail RSS"} 
        href={isNSFW ? "/nsfw-rss.xml" : "/rss.xml"} />
		
		<title>{`Dragontail - ${title}`}</title>
		
		<!-- OGP Meta Tags -->
		<meta property="og:site_name" content={siteName} />
		<meta property="og:title" content={`${siteName} - ${title}`} />
		<meta property="og:description" content={pageDescription} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={pageUrl} />
		<meta property="og:image" content={pageImage} />
		
	</head>
	<body>
	<header>
    <div class="header-navigation">
        <h1><a href={isNSFW ? "/nsfw-gallery/gallery/1" : "/gallery/1"}>Dragontail</a></h1>
        <a href={isNSFW ? "/nsfw-gallery/gallery/1" : "/gallery/1"}>ギャラリー</a>
        <a href={isNSFW ? "/nsfw-downloads/list" : "/downloads/list"}>配布物</a>
        <a href="/misc/">そのほか</a>
        {isNSFW && <span style="color: #f66; font-weight: bold;">18+</span>}
    </div>
    <div id="test">
        <p><a href={isNSFW ? "/nsfw-gallery/gallery/1" : "/gallery/1"}>[新着]</a></p>
        <p><a href={isNSFW ? "/nsfw-gallery/tags" : "/tags"}>[タグ一覧]</a></p>
        {isNSFW && <p><a href="/gallery/1">[SFWに戻る]</a></p>}
    </div>
	</header>
		<main>
			<slot />
		</main>
		<footer>
    <p>
        <a href={isNSFW ? "/nsfw-gallery/" : "/"}>index</a> | 
        <a href="/contact">[連絡先]</a> | 
        <a href={isNSFW ? "/nsfw-rss.xml" : "/rss.xml"}>[RSS]</a>
    </p>
    <p>©2025 しもふみ</p>
</footer>
	</body>
</html>
