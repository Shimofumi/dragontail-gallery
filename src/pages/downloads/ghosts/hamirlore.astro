		<h2>ヘイミル・ロゥ</h2>
		<p class="download-category-label">伺かゴースト</p>
		
		<section class="download-preview">
			<h3>プレビュー</h3>
			<img src="/downloads/ghosts/hamirlore/0533固定用.png" alt="へーちゃんプレビュー">
		</section>
		
